# Copy to .env and edit values as needed for local development

# Postgres DSN (user:password@host:port/dbname)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/sampledb?sslmode=disable

# Redis address
REDIS_ADDR=localhost:6379

# HTTP server port
HTTP_PORT=8080

# Service metadata
SERVICE_NAME=sample-api
SERVICE_VERSION=0.1.0
ENV=local
