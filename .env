# HTTP server port
HTTP_PORT=8080

# Service metadata
SERVICE_NAME=sample-api
SERVICE_VERSION=0.1.0
ENVIRONMENT=local

# Redis address
REDIS_ADDR=localhost:6379

# OpenTelemetry configuration
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Postgres DSN (user:password@host:port/dbname)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/sampledb?sslmode=disable
